rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isPdfUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf');
    }

    match /products/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    match /banners/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    match /campaigns/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    match /brand/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    match /hamster-spin-images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    match /stores/{companyId}/branding/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    match /stores/{companyId}/media/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    match /invoices/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isPdfUnder5MB();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}